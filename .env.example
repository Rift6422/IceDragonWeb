# ============================================================
# icedragon-pay 環境變數範本
# 用法:cp .env.example .env.local 並填入實際值
# .env.local 不會被 commit(已在 .gitignore)
# ============================================================

# === Node 環境 ===
NODE_ENV=development
PORT=3000

# === 資料庫(外接 PostgreSQL,由 DBA 提供連線資訊)===
# 範例格式:postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
# 重要:
#   - PostgreSQL 不在本 repo 的 Docker 內,連線由外部提供
#   - 正式環境建議 sslmode=require
#   - 連線字串視為 secret,不可 commit
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/icedragon_pay?schema=public

# === Redis(reserved,MVP 不使用)===
# MVP 階段 dispatch 同步觸發,重試靠 MyCard §3.6 補儲(最多 5 次)driven。
# 若未來導入 pg-boss 主動重試佇列,queue 走 Postgres,仍不需要 Redis。
# 只在實際接 BullMQ 時才填入。
# REDIS_URL=redis://localhost:6379

# === 玩家前台 ===
PLAYER_FRONTEND_URL=http://localhost:5173

# 玩家商城 base path(遊戲命名空間前綴)。MyCard 付款完的返回會導到
# {PLAYER_STORE_BASE_PATH}/?paid=...,玩家停在帶前綴的商城(與 root 強制轉入一致)。
# 留空 = root。單一遊戲(神代紀事)設 /shindai-record。
PLAYER_STORE_BASE_PATH=/shindai-record

# === JWT(Admin 後台登入用,≥ 32 字元高熵)===
# 產生方式:python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<請產生 ≥ 32 字元隨機字串>
JWT_EXPIRES_IN=8h

# === 後台預設帳號(開機 bootstrap 同步進 DB)===
# 改密碼 = 改這裡 → Redeploy(不用碰 DB、不重 build);env 是密碼唯一來源
# 不填 → 預設 admin / admin123(僅 dev 方便,正式環境務必改成強密碼)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# === 後台 IP 白名單(reserved,預設關閉)===
# 啟用後,只有 ADMIN_IP_WHITELIST_LIST 內列的 IP 可呼叫 /api/admin/*
# 注意:Cloudflare 後面要透 trust proxy 拿真實 IP
ADMIN_IP_WHITELIST_ENABLED=false
# ADMIN_IP_WHITELIST_LIST=1.2.3.4,5.6.7.8

# === Google OAuth ===
GOOGLE_OAUTH_CLIENT_ID=<Google Cloud Console 申請>
GOOGLE_OAUTH_CLIENT_SECRET=<Google Cloud Console 申請>
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# === MyCard 介接 ===
# Hash 用 Key — 機密,絕對不要 commit
MYCARD_HASH_KEY=<32 碼英數混合,大小寫有別,無符號>

# MyCard 發給的識別(等 MyCard 回覆介接資料表後填入)
MYCARD_FAC_SERVICE_ID=
MYCARD_FAC_GAME_ID=
MYCARD_FAC_GAME_NAME=神代紀事

# MyCard API endpoint
MYCARD_API_BASE_TEST=https://testb2b.mycard520.com.tw/MyBillingPay/v1.6
MYCARD_API_BASE_PROD=https://b2b.mycard520.com.tw/MyBillingPay/v1.6
MYCARD_SANDBOX_MODE=true
# Mock mode:不打真實 MyCard API,回 stub。未設預設 true → **正式環境必設 false**
MYCARD_MOCK_MODE=true

# 我方回傳網址(填到 AuthGlobal 的 FacReturnURL)。
# 玩家來源網域不在 PLAYER_RETURN_ORIGINS 白名單時的 fallback。
MYCARD_FAC_RETURN_URL=http://localhost:3000/api/mycard/trade-result

# 允許動態返回的玩家網域白名單(逗號分隔完整 origin)。
# 同一部署同時服務 pay / pay-test 時兩個都列上,玩家付款完回原網域(不再被固定導去某一個)。
# 未列到的來源會 fallback 到上面的 MYCARD_FAC_RETURN_URL(防偽造 Origin 開放轉址)。
PLAYER_RETURN_ORIGINS=https://pay.icedragon-games.com,https://pay-test.icedragon-games.com

# MyCard 入站 callback 的合法來源 IP(用於白名單驗證,逗號分隔)
MYCARD_INBOUND_IP_TEST=218.32.37.148,40.83.124.36
MYCARD_INBOUND_IP_PROD=220.130.127.125,40.81.30.67,40.81.29.75,210.71.189.165,210.71.189.161

# MyCard callback 的合法 User-Agent
MYCARD_USER_AGENT=MyCardGlobalBilling/1.0

# === MyCard 直接儲值(Model B,SHA-1)===
# 由 MyCard 合約時提供。不開 Model B 就留空,backend 啟動時會自動不掛載相關 endpoint。
# MYCARD_DIRECT_KEY1=
# MYCARD_DIRECT_KEY2=

# === 派發到玩家庫存 ===
# 走 PlayFab Server API(由 Unity team 提供 Title ID + Secret Key)
# - PlayFab Title ID:在 PlayFab Game Manager 主頁可看到
# - Secret Key:Settings → Secret Keys,等級**等同 MyCard Hash Key** 機密保護
# - CloudScript 函式名:若 Unity team 用 Pattern 2(我方呼 CloudScript)才需要
#
# 若還沒接 PlayFab,留空 → MailDispatcher 走 MockMailDispatcher
# 不會真打 PlayFab,訂單直接標 DELIVERED(僅 dev 用)。
PLAYFAB_TITLE_ID=
PLAYFAB_SECRET_KEY=
PLAYFAB_CLOUD_SCRIPT_FN=
PLAYFAB_API_TIMEOUT_MS=10000

# === Game Backend(遊戲端 Azure Functions / PlayFab proxy)===
# 由遊戲端提供。目前用到的 endpoint:
#   - /api/getstoreitems         → 玩家限購剩餘 + canDouble (STOREITEMS_FUNCTION_CODE)
#   - /api/grantrmproduct        → 派發到遊戲信箱 (GRANT_FUNCTION_CODE)
#   - /api/getneworderavailable  → 建單前鎖商品防重買 (LOCK_FUNCTION_CODE)
#   - /api/updateorderstatus     → 付款完成 / 失敗後解鎖商品 (UNLOCK_FUNCTION_CODE)
# 留空 → 進 stub 模式:玩家頁不顯示限購剩餘、派發走 mock、不鎖商品,不擋現有流程。
# 注意:舊 /api/getstorelimitations 已於 2026-05-26 從遊戲端下架,
#       對應的 GAME_BACKEND_FUNCTION_CODE 已棄用。
# 注意:LOCK 跟 UNLOCK 必須一起設,不然鎖了不解會殭屍化。
GAME_BACKEND_BASE_URL=
GAME_BACKEND_STOREITEMS_FUNCTION_CODE=
# /api/redeemmycoupon → 玩家序號兌換 (留空 → 序號兌換頁回「功能尚未開通」)
GAME_BACKEND_COUPON_FUNCTION_CODE=
GAME_BACKEND_GRANT_FUNCTION_CODE=
GAME_BACKEND_LOCK_FUNCTION_CODE=
GAME_BACKEND_UNLOCK_FUNCTION_CODE=
GAME_BACKEND_STORE_ID=
# PlayFab CatalogVersion(派發 grantrmproduct 必帶,由遊戲端提供)
GAME_BACKEND_CATALOG=
GAME_BACKEND_TIMEOUT_MS=5000

# === 訂單對帳 sweep(每 5 分鐘自動跑;補漏派獎 / 釋放卡單鎖 / 重試解鎖)===
# 開關,設 false 完全不跑
ORDER_SWEEP_ENABLED=true
# 卡單多久(分)才進對帳(太新的還在正常付款流程,先別碰)
ORDER_SWEEP_DELIVER_GRACE_MIN=10
# 未付的 PENDING/AUTHED 卡多久(分)就取消+解鎖。**必須 > MyCard 補儲窗 ~20 分**
ORDER_SWEEP_CANCEL_GRACE_MIN=60
# sweep 只 TradeQuery 這時數內的卡單;更舊的 AUTHED 直接取消(auth 早失效)
ORDER_SWEEP_MAX_AGE_HOURS=48

# === Facebook Pixel + CAPI(廣告歸因,廣告主用)===
# 同一個 Pixel,前後端雙端送 Purchase 事件,用 event_id(=facTradeSeq)去重。
# 沒設 → backend 自動 skip(FbCapiService.disabled=true),不會 crash;前端 Pixel 也是 no-op。
#
# 取得方式:
#   1. FB 商務管理工具 → Events Manager → Data sources
#   2. 選 Pixel(或建一個) → 「Pixel ID」是上面那串純數字 → FB_PIXEL_ID
#   3. 同一個 Pixel 點「Settings」→ 「Conversions API」→ 「Generate Access Token」 → FB_TOKEN
#   4. 測試期填「Test events code」(Test Events 頁面右上) → FB_EVENT_CODE,上線清空
#
# 安全:FB_TOKEN 機密程度等同 MYCARD_HASH_KEY,**絕不可進前端 bundle / commit / 印 log**
#
# Docker 部署:FB_PIXEL_ID 同時當 build ARG + runtime ENV
#   - build 階段:Dockerfile 自動 map 成 VITE_FB_PIXEL_ID inline 進前端 bundle
#   - runtime:後端 ConfigService 直接讀
#   - Zeabur 設定:在「Variables」設 FB_PIXEL_ID 一次,build / runtime 都會吃到
FB_PIXEL_ID=
FB_TOKEN=
FB_EVENT_CODE=

# === 媒體圖庫(上傳圖存 Volume)===
# 圖檔存持久化路徑,Zeabur Service → Storage 加 Volume,mount path 設成這個值。
UPLOAD_DIR=/app/uploads
# 媒體補檔來源站(選填,只在「新開 service、Volume 空的」時用):
#   設了 → 開機偵測 Volume 缺哪些 media 檔,自動從此站 /uploads/<filename> 補齊
#   (idempotent,補完即不再動作)。沒設 → 完全略過。
#   例:新正式 service 首發時填測試站 origin,補完可留著(補齊後每次開機秒過)
# MEDIA_BACKFILL_SOURCE_URL=https://pay-test.icedragon-games.com

# === 觀測 ===
SENTRY_DSN=
LOG_LEVEL=info
